{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/submit-launch.js": {
      "maxDuration": 10
    },
    "api/rpc.js": {
      "maxDuration": 10
    },
    "api/admin.js": {
      "maxDuration": 10
    },
    "api/public.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/public/:action",
      "destination": "/api/public?action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
