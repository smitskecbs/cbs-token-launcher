{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/submit-launch.js": {
      "maxDuration": 10
    },
    "api/admin-login.js": {
      "maxDuration": 10
    },
    "api/list-launch-submissions.js": {
      "maxDuration": 10
    },
    "api/update-launch-submission-status.js": {
      "maxDuration": 10
    },
    "api/homepage-launches.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
